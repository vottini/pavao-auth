
type positiveInteger : integer (min=0)

type userId: positiveInteger
type roleId: positiveInteger
type funcId: positiveInteger

type saneName: string (minLength=2)
type saneLogin: string(minLength=4, format="^[a-z][a-z0-9]*(?:.[a-z0-9]+)?$")
type sanePassword: string(minLength=8)

object userInfo {
	id: userId,
	firstName: saneName,
	lastName: nullable saneName,
	active: bool,
	isAdmin: bool,
	myAccount: bool
}

object userAssignmentStatus {
	firstName: saneName,
	lastName: nullable saneName,

	assignments: {
		id: roleId,
		name: string,
		assigned: bool
	} []
}

object passwordUpdate {
	password: sanePassword,
	optional changePassword: bool
}

object userCreationData {
	login: saneLogin,
	password: sanePassword,
	firstName: saneName,
	optional lastName: saneName,
	changePassword: bool
}

object fullUserData {
	login: string,
	firstName: saneName,
	lastName: nullable saneName,
	creation: instant,
	lastLogin: nullable instant,
	active: bool,
	admin: bool,

	roles: {
		id: roleId,
		name: string
	} []
}

object userUpdate {
	optional login: saneLogin,
	optional firstName: saneName,
	optional lastName: nullable saneName
}

object roleInfo {
	id: roleId,
	name: saneName,
	description: nullable string
}

object fullRoleData {
	name: saneName,
	description: nullable string,

	users: {
		id: userId,
		fullName: string
	} [],

	functionalities: {
		id: funcId,
		name: string,
		package: nullable string
	} []
}

object roleCreationData  {
	name: saneName,
	optional description: string
}

object roleUpdate {
	optional name: saneName,
	optional description: string
}

object roleAccesses {
	name: saneName,
	accesses: {
		package: nullable string,
		functionalities: {
			id: funcId,
			functionality: string,
			accessable: bool
		} []
	} []
}

object packageFunctionalities {
	package: nullable string,

	functionalities: {
		id: funcId,
		functionality: string,
		enabled: bool,
		active: bool
	} []
}

object allowedFunctionality {
	package: string,
	functionality: string,
	allowingRole: string
}


object packageInfo {
	package: string,

	tasks: {
		id: funcId,
		name: string,
		enabled: bool
	} []
}

object functionalityInfo {
	package: nullable string,
	name: string,
	schedule: string,
	enabled: bool,
	optional nextExecution: instant,
	running: bool
}

object updatedSchedule {
	nextExecution: instant
}

object taskExecution {
	start: instant,
	finish: instant,
	success: bool,

	outputs: {
		instant: instant(iso=true),
		content: string
	} []
}

