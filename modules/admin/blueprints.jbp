
type PositiveInteger: Integer(min=0)
type NonBlankString: String(minLength=1)
type SanePassword: String(minLength=8)

type UserId: PositiveInteger
type RoleId: PositiveInteger
type FuncId: PositiveInteger

#----------------------------------------------- Users

object UserCreation {
	login: NonBlankString,
	password: SanePassword,
	firstName: NonBlankString,
	optional lastName: NonBlankString,
	changePassword: Bool
}

object UserUpdate {
	optional login: NonBlankString,
	optional firstName: NonBlankString,
	optional lastName: nullable NonBlankString
}

object PasswordUpdate {
	password: SanePassword,
	optional changePassword: Bool
}

object CoreUserInfo {
	id: UserId,
	login: String,
	firstName: NonBlankString,
	lastName: nullable NonBlankString,
	active: Bool
}

object UserInfo extends CoreUserInfo {
	myAccount: Bool,
	admin: Bool
}

object UserAssignments extends CoreUserInfo {
	assignments: {
		id: RoleId,
		name: NonBlankString,
		assigned: Bool
	} []
}

object FullUserInfo extends CoreUserInfo {
	creation: Instant,
	lastLogin: nullable Instant,
	admin: Bool
}

object BasicUserInfo {
	id: UserId,
	fullName: NonBlankString
}

#----------------------------------------------- Roles

object RoleCreation {
	name: NonBlankString,
	optional description: String,
	optional code: String
}

object RoleUpdate {
	optional name: NonBlankString,
	optional description: NonBlankString
}

object CoreRoleInfo {
	id: RoleId,
	name: NonBlankString
}

object UserRoles extends FullUserInfo {
	roles: CoreRoleInfo[]
}

object RoleInfo extends CoreRoleInfo {
	description: nullable String
}

#----------------------------------------------- Functionalities

object FunctionalityInfo {
	id: FuncId,
	package: nullable NonBlankString,
	name: NonBlankString
}

object FullRoleInfo extends RoleInfo {
	functionalities: FunctionalityInfo[],
	users: BasicUserInfo[]
}

object RoleAccesses extends CoreRoleInfo {
	accessable: FunctionalityInfo[],
	forbidden: FunctionalityInfo[]
}

object PackageFunctionalities {
	package: nullable NonBlankString,

	functionalities: {
		id: FuncId,
		functionality: NonBlankString,
		enabled: Bool
	} []
}

object AllowedFunctionality {
	package: nullable NonBlankString,
	functionality: String,
	allowingRole: String
}

#------------------------------------------- Tasks

object PackageTasks {
	package: nullable NonBlankString,

	tasks: {
		id: FuncId,
		name: NonBlankString,
		enabled: Bool
	} []
}

object TaskInfo {
	package: nullable NonBlankString,
	name: NonBlankString,
	schedule: NonBlankString,
	enabled: Bool,
	running: Bool,
	optional nextExecution: Instant
}

object UpdatedSchedule {
	nextExecution: Instant
}

object TaskExecution {
	start: Instant,
	finish: Instant,
	success: Bool,

	outputs: {
		instant: Instant(iso=true),
		content: String
	} []
}

