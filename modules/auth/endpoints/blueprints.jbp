
type Password: String(minLength=8, maxLength=128)

object Credentials {
	login: String(minLength=2, maxLength=128),
	password: Password
}

object TokenInfo {
	access_token: String,
	token_type: String,
	expires_in: Integer
}

object LoginInfo extends TokenInfo {
	change_password: Bool
}

object PasswordUpdate {
	oldPassword: Password,
	newPassword: Password
}

object Access {
	package: nullable String,
	functionality: String
}

object UserInfo {
	id: Integer,
	firstName: String,
	lastName: nullable String,
	administrator: Bool,
	accesses: Access[]
}

